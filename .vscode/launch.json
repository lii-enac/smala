{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "(lldb) smala - cookbook (macOS)",
            "type": "lldb",
            "request": "launch",
            "program": "${workspaceFolder}/${config:build_dir}/cookbook/gui/7GUIs/6-circle-drawer/6-circle-drawer_app",
            "args": [],
            "cwd": "${workspaceFolder}/cookbook/gui/7GUIs/6-circle-drawer",
            "env": {
                "DYLD_LIBRARY_PATH": "${env:DYLD_LIBRARY_PATH}:${workspaceFolder}/../djnn-cpp/${config:build_dir}/lib:${workspaceFolder}/../smala/${config:build_dir}"
            },
            // "sourceMap": {
            //     "${workspaceFolder}/build/Darwin-x86_64": "${workspaceFolder}/src"
            // },
            "preLaunchTask": "app"
        },
        {
            "name": "(lldb) smala - cookbook simplest (macOS)",
            "type": "lldb",
            "request": "launch",
            "program": "${workspaceFolder}/${config:build_dir}/cookbook/gui/direct_manipulation/simplest/simplest_app",
            "args": [],
            "cwd": "${workspaceFolder}/cookbook/gui/direct_manipulation/simplest",
            "env": {
                "DYLD_LIBRARY_PATH": "${env:DYLD_LIBRARY_PATH}:${workspaceFolder}/../djnn-cpp/${config:build_dir}/lib:${workspaceFolder}/../smala/${config:build_dir}/lib"
            },
            // "sourceMap": {
            //     "${workspaceFolder}/build/Darwin-x86_64": "${workspaceFolder}/src"
            // },
            "preLaunchTask": "simplest"
        },
        {
            "name": "(gdb) smala - cookbook (Linux)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/${config:build_dir}/cookbook/gui/direct_manipulation/simplest/simplest_app",
            "args": [],
            "cwd": "${workspaceFolder}/cookbook/gui/direct_manipulation/simplest",
            "environment": [
                {
                    "name": "LD_LIBRARY_PATH",
                    "value": "${env:LD_LIBRARY_PATH}:${workspaceFolder}/../djnn-cpp/${config:build_dir}/lib:${workspaceFolder}/../smala/${config:build_dir}/lib"
                }
            ],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "preLaunchTask": "app",
            // "sourceFileMap": {
            //     "${workspaceFolder}/build": "${workspaceFolder}"
            // }
        }
    ]
}
